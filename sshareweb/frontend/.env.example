# Copy to .env for local development.
# Signaling WebSocket (rooms + SDP/ICE relay). Falls back to ws://localhost:8787/ws.
VITE_SIGNALING_URL=ws://localhost:8787/ws
# Rust gateway for inventory + deliberate HTTP fallback. Falls back to http://localhost:8080.
VITE_SSHARE_API_URL=http://localhost:8080
# Base URL embedded in QR share links (e.g. http://192.168.1.5:5173 on your
# LAN, or https://share.example.com in production). Falls back to the page's
# own origin. No secrets here — only URLs.
# VITE_RECEIVER_BASE_URL=http://192.168.1.5:5173
# STUN servers (comma-separated). No secrets here — TURN credentials are
# minted at runtime via POST /api/turn-creds and live only in memory.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional WebRTC tuning (ms / bytes). Defaults are production-sane.
# VITE_RTC_CONNECTION_TIMEOUT_MS=25000
# VITE_RTC_GATHERING_TIMEOUT_MS=8000
# VITE_RTC_BACKPRESSURE_BYTES=1048576
# VITE_RTC_RESUME_WAIT_MS=1500
# VITE_RTC_STATS_POLL_MS=3000
